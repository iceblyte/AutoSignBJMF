// 本文件是 UTF-8。不加这一行，windres / rc.exe 会按系统 ANSI 代码页（中文机器上是 GBK）解析，
// 结果就是任务管理器里「属性 → 详细信息」那几栏中文全是乱码。
#pragma code_page(65001)

1 ICON "assets\\app.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "080404B0"
    {
      VALUE "CompanyName", "AutoSignBJMF"
      VALUE "FileDescription", "班级魔方自动签到"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "AutoSignBJMF"
      VALUE "OriginalFilename", "AutoSignBJMF.exe"
      VALUE "ProductName", "班级魔方自动签到"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "MIT License"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x804, 1200
  }
}
